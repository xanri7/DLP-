{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DLP Policy Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policies"
  ],
  "properties": {
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "enabled",
          "channel",
          "conditions",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "channel": {
            "enum": [
              "clipboard",
              "usb"
            ]
          },
          "conditions": {
            "type": "object"
          },
          "action": {
            "enum": [
              "ALLOW",
              "WARN",
              "BLOCK"
            ]
          }
        }
      }
    }
  }
}
